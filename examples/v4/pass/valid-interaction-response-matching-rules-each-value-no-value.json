            "$.a": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "eachValue",
                  "rules": [
                    {
                      "match": "type",
                      "min": 1
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "provider": {
    "name": "A provider"
  },
